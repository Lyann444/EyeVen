# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=change-me-in-production

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=eyeven
MYSQL_USER=eyeven
MYSQL_PASSWORD=eyeven_password
DATABASE_URL=mysql+pymysql://eyeven:eyeven_password@localhost:3306/eyeven

# Z AI GLM
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
GLM_API_KEY=your-glm-api-key-here
GLM_MODEL=glm-4

# File Upload
MAX_UPLOAD_SIZE_MB=50
MAX_ZIP_FILES=20
UPLOAD_FOLDER=uploads

# OCR
PADDLEOCR_LANG=en

# External Verification (SST Portal Scraping)
SST_PORTAL_URL=https://sst01.customs.gov.my/account/inquiry
SCRAPE_TIMEOUT_SECONDS=15

# Frontend
REACT_APP_API_URL=http://localhost:5000/api
